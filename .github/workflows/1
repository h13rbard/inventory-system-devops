name: Build and Deploy
runs-on: ubuntu-latest

```
steps:
  - name: Checkout repository
    uses: actions/checkout@v4

  - name: Configure AWS credentials
    uses: aws-actions/configure-aws-credentials@v4
    with:
      aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
      aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
      aws-region: ${{ secrets.AWS_REGION }}

  - name: Login to Amazon ECR
    id: login-ecr
    uses: aws-actions/amazon-ecr-login@v2

	* name: Debug AWS
  	run: |
  	aws sts get-caller-identity
  	aws ecr describe-repositories

	* name: Set image tags
  	run: |
  	echo "PHP_IMAGE=${{ secrets.AWS_ACCOUNT_ID }}.dkr.ecr.${{ secrets.AWS_REGION }}.amazonaws.com/inventory-php:latest" >> $GITHUB_ENV
  	echo "NGINX_IMAGE=${{ secrets.AWS_ACCOUNT_ID }}.dkr.ecr.${{ secrets.AWS_REGION }}.amazonaws.com/inventory-nginx:latest" >> $GITHUB_ENV

	* name: Build PHP image
  	run: |
  	docker build -t $PHP_IMAGE -f docker/php/Dockerfile .

	* name: Push PHP image
  	run: |
  	docker push $PHP_IMAGE

	* name: Build NGINX image
  	run: |
  	docker build -t $NGINX_IMAGE -f docker/nginx/Dockerfile .

	* name: Push NGINX image
  	run: |
  	docker push $NGINX_IMAGE

  - name: Force ECS deployment
    run: |
      aws ecs update-service \
        --cluster syslac-cluster \
        --service syslac-service \
        --force-new-deployment
